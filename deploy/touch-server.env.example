# touch-engine server env sample (HUI-1746 T0)
# 目标路径(生产惯例):/etc/touch-engine/touch-server.env (0640, 不进 git)
# 值纪律:样例只有键名与说明,永不写入真实 token。

# ---- app ----
# 服务监听(loopback,不对公网;18240 避开 18101-18107/18220/18230/18320)
TOUCH_HTTP_ADDR=127.0.0.1:18240
# sqlite 数据文件路径(独立数据目录)
TOUCH_DB_PATH=/var/lib/touch-engine/touch.db
# development | production
TOUCH_ENV=production
# 平台 app_id(JWT aud;需平台侧 AUTH_APPS 登记)
TOUCH_APP_ID=touch-engine
# web BFF -> 本服务共享内部令牌(随机生成,不与平台服务令牌复用)
TOUCH_INTERNAL_TOKEN=
# 携带 identity 会话令牌的 Cookie 名
TOUCH_SESSION_COOKIE=touch_session

# ---- platform identity(必配;缺任一键 = 鉴权动作全部 fail-closed)----
PLATFORM_IDENTITY_BASE_URL=http://127.0.0.1:18101
# 本 app 专用 identity 令牌(平台侧 IDENTITY_APP_TOKENS 登记;禁止万能 token)
PLATFORM_IDENTITY_TOKEN=
# canonical host(BFF 会话转发时的 Host 约定)
PLATFORM_IDENTITY_APP_HOST=touch.example.com

# ---- platform upload(素材引用校验;开关默认 off)----
FEATURE_UPLOAD=off
PLATFORM_UPLOAD_BASE_URL=http://127.0.0.1:18104
# 平台侧 UPLOAD_APP_TOKENS 登记的专用令牌
PLATFORM_UPLOAD_TOKEN=

# ---- platform notify(本票仅脚手架;开关默认 off)----
FEATURE_NOTIFY=off
PLATFORM_NOTIFY_BASE_URL=http://127.0.0.1:18105
# 平台侧 NOTIFY_APP_TOKENS 登记的专用令牌
PLATFORM_NOTIFY_TOKEN=

# ---- platform task(本票仅脚手架;开关默认 off)----
FEATURE_TASK=off
PLATFORM_TASK_BASE_URL=http://127.0.0.1:18103
# 平台侧 TASK_APP_TOKENS 登记的专用令牌
PLATFORM_TASK_TOKEN=

# ---- HUI-1668 活动轻文案(全部留空 = 不调用模型,失败关闭,禁止假成功)----
# 报价走平台 billing,生成走平台 task。缺任一键都不会提交任务,也不会编造文案。
# 这里不创建 GoBoost 工程。不要把真实令牌写进仓库。
PLATFORM_BILLING_BASE_URL=http://127.0.0.1:18102
PLATFORM_BILLING_TOKEN=
COPY_MODEL_PROVIDER=
COPY_MODEL_ID=
COPY_MODEL_VERSION=
COPY_PRICING_VERSION=

# ---- 矩阵草稿供给(可选)----
# 两个都留空:不安装客户端,不拨号。不要把地址写成没有进程也会拨号的生产默认值。
# 本地验收只有 127.0.0.1:18741 真的在听时,才把下面两项都设为 http://127.0.0.1:18741。
# 那个端口没有进程时保持空白;拨号失败只停矩阵按钮,不会变成外发完成。
TOUCH_PUBLIC_PERMISSION_URL=
TOUCH_MATRIX_DRAFT_URL=
