# Additional configuration for M11 navigation; source after the original
# touch-server + web env. Values below are placeholders, not registration.
LEADS_FOLLOW_UP_BASE_URL=http://127.0.0.1:18331
LEADS_FOLLOW_UP_TOKEN=REPLACE_WITH_EXISTING_LEADS_INTERNAL_SERVICE_TOKEN
TOUCH_SESSION_COOKIE=touch-engine_session
# Must be the actual Identity-registered canonical Touch host. Leave empty
# until registered; the SSO bridge then refuses to mint a local session.
SSO_APP_HOST=
IDENTITY_SSO_EXCHANGE_URL=http://127.0.0.1:18101/api/auth/sso/exchange
